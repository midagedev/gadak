---
import Base from '../layouts/Base.astro'
import Door from '../components/Door.astro'
import Thread from '../components/Thread.astro'
import MediaSlot from '../components/MediaSlot.astro'
import { strings, type Locale } from '../i18n'

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const t = strings[lang]
const installHref = lang === 'en' ? '/install/' : '/ko/install/'
---

<Base lang={lang} title={t.title} description={t.description}>
  {/* Hero: the promise first. Speed is the product; prove it in the same
      viewport with the recorded flagship, not a rendered mockup. */}
  <section class="hero">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1>{t.hero.heading}</h1>
    <p class="lede">{t.hero.lede}</p>
    <div class="doors">
      <Door primary href={installHref} title={t.hero.doors.installTitle} sub={t.hero.doors.installSub} />
    </div>
    <figure class="flagship">
      <MediaSlot
        slot={lang === 'en' ? 'flagship · 20k mirror' : '플래그십 · 2만 건 미러'}
        src="/media/scale.mp4"
        poster="/media/scale-poster.png"
        autoplay
      />
      <figcaption>{t.hero.videoCaption}</figcaption>
    </figure>
  </section>

  <Thread label={t.speed.label} />

  {/* Measurements right under the hero: the video says "fast", the table
      says how much, against the thing people wait on today. The REST
      comparison is the claim — same question, two runtimes. */}
  <section class="speed">
    <h2>{t.speed.heading}</h2>
    <table>
      <thead>
        <tr>
          <th></th>
          <th>{t.speed.colRest}</th>
          <th>{t.speed.colGadak}</th>
          <th aria-hidden="true"></th>
        </tr>
      </thead>
      <tbody>
        {
          t.speed.rows.map((row) => (
            <tr>
              <td class="what">{row.what}</td>
              <td class="rest">{row.value}</td>
              <td class="gadak">{row.alt}</td>
              <td class="ratio">{row.ratio}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="note">{t.speed.note}</p>
    <p class="note strong">{t.speed.localHeading} — {t.speed.localNote}</p>
  </section>

  {/* The live demo, one scroll below the numbers: the door is here for the
      reader who wants to touch it, not the one skimming the fold. */}
  <section class="demo">
    <h2>{t.demo.heading}</h2>
    <p>{t.demo.body}</p>
    <a class="demo-cta" href="/demo/">{t.demo.cta}</a>
  </section>

  <Thread label={t.ux.label} />

  {/* The daily loop: three exhibits, each a real recording or an honest
      placeholder until its take lands. Alternating text/media, no card grid. */}
  <section class="exhibit">
    <div class="text">
      <h2>{t.ux.search.heading}</h2>
      <p>{t.ux.search.body}</p>
    </div>
    <MediaSlot
      slot={lang === 'en' ? 'search' : '검색'}
      src="/media/search.mp4"
      poster="/media/search-poster.png"
    />
  </section>

  {/* Stills, not videos (GDK-751): these two claims read from one frame, so
      each ships a core-region crop at recorded glyph scale instead of a
      full-screen clip. */}
  <section class="exhibit stacked">
    <div class="text">
      <h2>{t.ux.group.heading}</h2>
      <p>{t.ux.group.body}</p>
    </div>
    <MediaSlot
      slot={lang === 'en' ? 'group-by' : '묶기'}
      still="/media/groupby-still.png"
      alt={t.ux.group.alt}
      displayWidth={594}
    />
  </section>

  <section class="exhibit stacked">
    <div class="text">
      <h2>{t.ux.history.heading}</h2>
      <p>{t.ux.history.body}</p>
    </div>
    <MediaSlot
      slot={lang === 'en' ? 'history' : '히스토리'}
      still="/media/history-still.png"
      alt={t.ux.history.alt}
      displayWidth={440}
    />
  </section>

  <Thread label={t.agent.label} />

  <section class="agent">
    <h2>{t.agent.heading}</h2>
    <p>{t.agent.body}</p>
    <figure class="media-pair">
      <MediaSlot
        slot={lang === 'en' ? 'agent round' : '에이전트 한 판'}
        src="/media/agent.mp4"
        poster="/media/agent-poster.png"
      />
      <figcaption>{t.agent.videoCaption}</figcaption>
    </figure>
    <pre><code>{`gadak create NMB "Ship the export" --field team=platform
gadak claim NMB-1042
gadak transition NMB-1042 done -m "shipped"`}</code></pre>
    <figure class="media-pair">
      {/* The recorded Claude Code tape from the README (user call 2026-08-24):
          the claim here is a conversation flow, not a single frame, so this
          exhibit plays the tape rather than a still. */}
      <MediaSlot
        slot={lang === 'en' ? 'live MCP session' : '라이브 MCP 세션'}
        src="/media/mcp.mp4"
        poster="/media/mcp-poster.png"
      />
      <figcaption>{t.agent.mcpCaption}</figcaption>
    </figure>
    <p class="caption">{t.agent.snippetCaption}</p>
    <pre><code>{`gadak skill install                  # shell agents (Claude Code, Codex…)
claude mcp add gadak -- gadak mcp    # MCP clients`}</code></pre>
    <p class="note">
      <a href="https://github.com/midagedev/gadak/blob/main/docs/AGENT_SETUP.md">{t.agent.setupLink}</a>
    </p>
  </section>

  <Thread label={t.origin.label} />

  <section class="origin">
    <h2>{t.origin.heading}</h2>
    <ul>
      {t.origin.points.map((point) => <li>{point}</li>)}
    </ul>
  </section>

  <Thread />

  <section class="workspace">
    <h2>{t.workspace.heading}</h2>
    <p>{t.workspace.body}</p>
    <pre><code>{`gadak init --standalone      # no tracker at all — issues live on this machine
gadak --workspace side init  # a second workspace: separate file, separate credentials`}</code></pre>
  </section>

  <Thread />

  <section class="install">
    <h2>{t.install.heading}</h2>
    <pre><code>{`brew install --cask midagedev/tap/gadak   # macOS app (CLI included)
brew install midagedev/tap/gadak-cli     # CLI only (macOS, Linux)

gadak init && gadak sync && gadak serve`}</code></pre>
    <p class="note"><a href={installHref}>{lang === 'en' ? 'All platforms →' : '모든 플랫폼 →'}</a></p>
  </section>
</Base>

<style>
  .hero {
    padding-top: 3.5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .hero h1 {
    font-size: 2.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0 0 1.1rem;
    max-width: 22ch;
  }
  .lede {
    font-size: 1.0625rem;
    color: var(--ink-2);
    margin: 0 0 2rem;
    max-width: 58ch;
  }
  .doors {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 40rem) {
    .doors {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .flagship {
    margin: 0;
  }
  figcaption {
    font-size: 0.8125rem;
    color: var(--ink-3);
    margin-top: 0.6rem;
  }

  .speed table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--border);
  }
  .speed th {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: right;
    color: var(--ink-3);
    padding: 0.5rem 0 0.35rem;
  }
  .speed th:first-child {
    text-align: left;
  }
  .speed td {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    text-align: right;
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .speed td.what {
    text-align: left;
    font-family: var(--font-sans);
    color: var(--ink-2);
    white-space: normal;
    padding-right: 1rem;
  }
  .speed td.rest {
    color: var(--ink-3);
  }
  .speed td.gadak {
    color: var(--ink);
    font-weight: 600;
  }
  .speed td.ratio {
    color: var(--accent);
    font-weight: 700;
    padding-left: 0.75rem;
  }
  /* Phone widths: value cells may wrap (numbers hold together via nbsp in
     the strings), otherwise the qualitative rows squeeze the first column
     down to one glyph per line. */
  @media (max-width: 40rem) {
    .speed td,
    .speed th {
      white-space: normal;
    }
    .speed td {
      font-size: 0.875rem;
    }
    .speed td.what {
      padding-right: 0.6rem;
    }
  }
  .speed .note {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin: 0.9rem 0 0;
  }
  .speed .note.strong {
    color: var(--ink-2);
  }
  .demo {
    text-align: center;
    margin-top: 4rem;
  }
  .demo-cta {
    display: inline-block;
    margin: 0.5rem 0 0;
    padding: 0.65rem 1.4rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .demo-cta:hover {
    background: var(--accent-subtle);
  }

  .exhibit {
    display: grid;
    gap: 1.75rem;
    margin-bottom: 3.5rem;
    align-items: start;
  }
  @media (min-width: 46rem) {
    .exhibit:not(.stacked) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  /* Stills stack: the crop renders at its native 1x width (MediaSlot
     displayWidth), centered, so recorded glyphs keep their size. */
  .exhibit.stacked {
    gap: 0.5rem;
  }
  .exhibit.stacked .text {
    max-width: 58ch;
  }
  .exhibit h2 {
    font-size: 1.25rem;
    margin: 0 0 0.6rem;
  }
  .exhibit p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9688rem;
  }

  section h2 {
    font-size: 1.375rem;
    margin: 0 0 0.75rem;
  }
  section > p {
    margin: 0 0 1rem;
    color: var(--ink-2);
    font-size: 1rem;
  }
  pre {
    margin: 0 0 1rem;
    padding: 1rem 1.25rem;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .caption {
    font-size: 0.875rem !important;
    color: var(--ink-3) !important;
    margin-top: 1.25rem !important;
  }
  .media-pair {
    margin: 1.5rem 0;
  }

  .origin ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .origin li {
    padding: 0.55rem 0 0.55rem 1.1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    position: relative;
    color: var(--ink-2);
  }
  .origin li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 0.55rem;
    height: 1px;
    background: var(--accent);
  }
</style>
