---
import Base from '../layouts/Base.astro'
import Door from '../components/Door.astro'
import Thread from '../components/Thread.astro'
import MediaSlot from '../components/MediaSlot.astro'
import Snippet from '../components/Snippet.astro'
import { strings, pathFor, mediaFor, CANONICAL_SQL, DATASETTE_DEMO_URL, type Locale } from '../i18n'

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const t = strings[lang]
const copyLabel = t.copy.label
const copiedLabel = t.copy.copied
const installHref = pathFor(lang, '/install/')
const storeHref = 'https://apps.microsoft.com/detail/9NZW91TXH36G'
const docs = 'https://github.com/midagedev/gadak/blob/main/'
// The sections and their order come from this locale's `layout` (i18n.ts):
// the three landings are parallel editions, not translations. The 2026-09-08
// review round (GDK-1632) set the shape every edition now follows — say what
// the tool is, prove it before asking for a token, put the facts a reader
// needs *before connecting work data* in one place, and end by asking what
// happened — while each locale keeps its own order inside that. A locale
// that has nothing to say in a section leaves it out of its layout rather
// than filling it.
const layout = t.layout
// The two hero doors in this locale's order, first one primary. Only `ja`
// sets heroDoorOrder today (its reader's machine may block brew, so the
// browser demo leads); every other locale gets install-then-demo.
const doorsByKey = {
  install: { href: installHref, title: t.hero.doors.installTitle, sub: t.hero.doors.installSub },
  demo: { href: '/demo/', title: t.hero.doors.demoTitle, sub: t.hero.doors.demoSub },
}
const heroDoors = (t.heroDoorOrder ?? ['install', 'demo']).map((k) => doorsByKey[k])
// Structured data for the one page a search result shows. The changelog page
// carries its own (with the release list); the landing says what the software
// is, in this locale, and where to get it (GDK-1659). No softwareVersion here:
// the tagged version is asserted on the READMEs by doc-checks, and a second
// hand-kept copy would drift.
const site = 'https://gadak.dev'
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'gadak',
  description: t.description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  inLanguage: lang,
  url: `${site}${pathFor(lang, '/')}`,
  downloadUrl: `${site}${installHref}`,
  sameAs: 'https://github.com/midagedev/gadak',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
})
---

<Base lang={lang} title={t.title} description={t.description} jsonLd={jsonLd}>
  {
    layout.map((section) => (
      <>
        {section === 'hero' && (
          <section class="hero">
            <p class="eyebrow">{t.hero.eyebrow}</p>
            <h1>{t.hero.heading}</h1>
            <p class="lede">{t.hero.lede}</p>
            <div class="doors">
              {heroDoors.map((d, i) => (
                <Door primary={i === 0} href={d.href} title={d.title} sub={d.sub} />
              ))}
            </div>
            <figure class="flagship">
              {/* Every clip on this page carries localized UI in its pixels, so
                  each asks mediaFor for this locale's cut and falls back to the
                  English take until that cut is recorded (MEDIA_LOCALES). */}
              <MediaSlot
                slot={t.landing.flagshipSlot}
                src={mediaFor(lang, '/media/scale.mp4')}
                poster={mediaFor(lang, '/media/scale-poster.png')}
                autoplay
              />
              <figcaption>{t.hero.videoCaption}</figcaption>
            </figure>
          </section>
        )}

        {section === 'query' && t.query && (
          <>
            <Thread label={t.query.label} />
            {/* The one claim a reader can test before installing anything: the
                canonical GROUP BY, and Datasette Lite running it on the demo
                snapshot in the browser. The SQL and the link are contract
                strings (FACT_LEDGER §7) and come from i18n.ts, not from copy. */}
            <section class="query">
              <h2>{t.query.heading}</h2>
              <p>{t.query.lead}</p>
              <Snippet code={CANONICAL_SQL} copyLabel={copyLabel} copiedLabel={copiedLabel} />
              <p class="note">
                <a href={DATASETTE_DEMO_URL}>{t.query.datasetteLabel}</a>
                <br />
                {t.query.result}
              </p>
            </section>
          </>
        )}

        {section === 'speed' && (
          <>
            <Thread label={t.speed.label} />
            <section class="speed">
              <h2>{t.speed.heading}</h2>
              <table>
                <thead>
                  <tr>
                    <th></th>
                    <th>{t.speed.colRest}</th>
                    <th>{t.speed.colGadak}</th>
                    <th aria-hidden="true"></th>
                  </tr>
                </thead>
                <tbody>
                  {t.speed.rows.map((row) => (
                    <tr>
                      <td class="what">{row.what}</td>
                      <td class="rest">{row.value}</td>
                      <td class="gadak">{row.alt}</td>
                      <td class="ratio">{row.ratio}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="note">
                {t.speed.note}
                <a href={`${docs}docs/BENCHMARKS.md`}>docs/BENCHMARKS.md</a>.
              </p>
            </section>
          </>
        )}

        {section === 'search' && (
          <>
            <Thread label={t.ux.label} />
            <section class="exhibit">
              <div class="text">
                <h2>{t.ux.search.heading}</h2>
                <p>{t.ux.search.body}</p>
              </div>
              <MediaSlot
                slot={t.landing.searchSlot}
                src={mediaFor(lang, '/media/search.mp4')}
                poster={mediaFor(lang, '/media/search-poster.png')}
              />
            </section>
          </>
        )}

        {section === 'agent' && (
          <>
            <Thread label={t.agent.label} />
            <section class="agent">
              <h2>{t.agent.heading}</h2>
              <p>{t.agent.body}</p>
              <figure class="media-pair">
                {/* Claude Code in gadak's own pane, and the board it moves is
                    the one above it. 16:10, full column width. Each locale's
                    take is one language end to end (MEDIA_LOCALES). */}
                <MediaSlot
                  slot={t.landing.agentSlot}
                  src={mediaFor(lang, '/media/terminal-hero.mp4')}
                  poster={mediaFor(lang, '/media/terminal-hero-poster.png')}
                />
                <figcaption>{t.agent.driveCaption}</figcaption>
              </figure>
              {/* The setup commands sit here only when this locale has not
                  moved them under Install (ko does: a reader who has not
                  installed gadak yet should not be handed the connect
                  command first — review round 2026-09-08). */}
              {t.agent.setup && (
                <>
                  <p>{t.agent.setup.skillLead}</p>
                  <Snippet code="gadak skill install" copyLabel={copyLabel} copiedLabel={copiedLabel} />
                  <p>{t.agent.setup.mcpLead}</p>
                  <Snippet code="gadak mcp install claude-desktop" copyLabel={copyLabel} copiedLabel={copiedLabel} />
                </>
              )}
              <p class="note">
                <a href={`${docs}docs/AGENT_SETUP.md`}>{t.agent.setupLink}</a>
                <br />
                <a href={`${docs}docs/SHOWCASE.md`}>{t.agent.showcaseLink}</a>
              </p>
            </section>
          </>
        )}

        {section === 'compare' && t.compare && (
          <>
            <Thread label={t.compare.label} />
            {/* en only. Capability and operating differences against the
                official hosted server, after the product has been shown —
                not a scoreboard. The row gadak loses is a real cost (a local
                binary and an initial sync), not a staged concession. */}
            <section class="speed compare">
              <h2>{t.compare.heading}</h2>
              <p>{t.compare.body}</p>
              <table>
                <thead>
                  <tr>
                    <th></th>
                    <th>{t.compare.colA}</th>
                    <th>{t.compare.colB}</th>
                  </tr>
                </thead>
                <tbody>
                  {t.compare.rows.map((row) => (
                    <tr>
                      <td class="what">{row.what}</td>
                      <td class="rest">{row.a}</td>
                      <td class="gadak">{row.b}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="note">
                {t.compare.note} <a href={`${docs}${t.compare.noteLink}`}>{t.compare.noteLink}</a>
              </p>
            </section>
          </>
        )}

        {section === 'connect' && (
          <>
            <Thread label={t.connect.label} />
            {/* The facts a reader needs before handing over a token, in one
                place: which Jira, how much gets copied, what stays local and
                how fresh it is, where the token goes, what leaves the machine,
                what a write does, what changes with an agent. Each line is a
                checkable claim (FACT_LEDGER §11); none is a verdict. */}
            <section class="connect">
              <h2>{t.connect.heading}</h2>
              <ul>
                {t.connect.points.map((point) => <li set:html={point} />)}
              </ul>
              <p class="note">
                {t.connect.links.map((l, i) => (
                  <>
                    {i > 0 && <br />}
                    <a href={l.href}>{l.label}</a>
                  </>
                ))}
              </p>
            </section>
          </>
        )}

        {section === 'install' && (
          <>
            <Thread label={t.install.label} />
            <section class="install">
              <h2>{t.install.heading}</h2>
              <p>{t.install.macosApp}</p>
              <Snippet code="brew install --cask midagedev/tap/gadak" copyLabel={copyLabel} copiedLabel={copiedLabel} />
              <p>{t.install.cliOnly}</p>
              <Snippet code="brew install midagedev/tap/gadak-cli" copyLabel={copyLabel} copiedLabel={copiedLabel} />
              <p>{t.install.windowsBefore} <a href={storeHref}>Microsoft Store</a>{t.install.windowsAfter}</p>
              <p>{t.install.firstRun}</p>
              <Snippet code="gadak init && gadak sync && gadak serve" copyLabel={copyLabel} copiedLabel={copiedLabel} />
              {t.install.setup && (
                <>
                  <p>{t.install.setup.skillLead}</p>
                  <Snippet code="gadak skill install" copyLabel={copyLabel} copiedLabel={copiedLabel} />
                  <p>{t.install.setup.mcpLead}</p>
                  <Snippet code="gadak mcp install claude-desktop" copyLabel={copyLabel} copiedLabel={copiedLabel} />
                </>
              )}
              <p class="note"><a href={installHref}>{t.landing.allPlatforms}</a></p>
            </section>
          </>
        )}

        {section === 'status' && (
          <>
            <Thread label={t.status.label} />
            {/* What the project is today — 0.x, one maintainer, the license,
                the work that stays in Jira — and where to read on. A first-time
                reader should not have to search the repository for this. */}
            <section class="status">
              <h2>{t.status.heading}</h2>
              <ul>
                {t.status.points.map((point) => <li set:html={point} />)}
              </ul>
              <p class="note">
                {t.status.links.map((l, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={l.href}>{l.label}</a>
                  </>
                ))}
              </p>
            </section>
          </>
        )}

        {section === 'ask' && (
          <>
            <Thread label={t.ask.label} />
            {/* No telemetry means the only retention signal is a human
                sentence, so every edition ends by asking for one — and says
                what must stay out of a public report. */}
            <section class="ask">
              <h2>{t.ask.heading}</h2>
              <p>{t.ask.body}</p>
              <p class="caution">{t.ask.caution}</p>
              <p class="note">
                {t.ask.links.map((l, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={l.href}>{l.label}</a>
                  </>
                ))}
              </p>
            </section>
          </>
        )}
      </>
    ))
  }
</Base>

<style>
  .hero {
    padding-top: 3.5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .hero h1 {
    font-size: 2.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0 0 1.1rem;
    max-width: 24ch;
    text-wrap: balance;
  }
  .lede {
    font-size: 1.0625rem;
    color: var(--ink-2);
    margin: 0 0 2rem;
    max-width: 58ch;
  }
  .doors {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 40rem) {
    .doors {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .flagship {
    margin: 0;
  }
  figcaption {
    font-size: 0.8125rem;
    color: var(--ink-3);
    margin-top: 0.6rem;
  }

  .speed table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--border);
  }
  .speed th {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: right;
    color: var(--ink-3);
    padding: 0.5rem 0 0.35rem;
  }
  .speed th:first-child {
    text-align: left;
  }
  .speed td {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    text-align: right;
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .speed:not(.compare) table {
    table-layout: fixed;
  }
  .speed:not(.compare) td.what {
    width: 40%;
  }
  .speed:not(.compare) td.rest,
  .speed:not(.compare) td.gadak {
    width: 22%;
  }
  .speed:not(.compare) td.ratio {
    width: 16%;
  }
  .speed td.what {
    text-align: left;
    font-family: var(--font-sans);
    color: var(--ink-2);
    white-space: normal;
    padding-right: 1rem;
  }
  .speed td.rest {
    color: var(--ink-3);
  }
  /* A minimum gutter between the two value columns. Both are right-aligned,
     so the column's widest cell always ends flush at the column edge, and
     without this the gadak cell touches the Jira cell in that row: measured
     on the ja page at 1280, "429 + Retry-After" ran into 「なし — 自分の
     ディスク」 as one token (GDK-1500 vision round). Only the gadak side
     needs it — the Jira cell's left neighbour is the left-aligned label,
     which carries its own padding-right — and every pixel here comes out
     of the label column: 1.25rem on both sides wrapped two English labels. */
  .speed td.gadak {
    color: var(--ink);
    font-weight: 600;
    padding-left: 1rem;
  }
  .speed td.ratio {
    color: var(--accent);
    font-weight: 700;
    padding-left: 0.75rem;
  }
  /* Phone widths: value cells may wrap (numbers hold together via nbsp in
     the strings), otherwise the qualitative rows squeeze the first column
     down to one glyph per line. */
  @media (max-width: 40rem) {
    .speed td,
    .speed th {
      white-space: normal;
    }
    .speed td {
      font-size: 0.875rem;
    }
    .speed td.what {
      padding-right: 0.6rem;
    }
  }
  .speed .note,
  .query .note {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin: 0.9rem 0 0;
    line-height: 1.8;
  }
  .query .note {
    margin-top: 0;
  }
  /* The comparison table: same skeleton as the measurement table, but its
     cells are words, not numbers — so they wrap and set in the sans face,
     and the two value columns share the width evenly. */
  .compare td.rest,
  .compare td.gadak {
    font-family: var(--font-sans);
    white-space: normal;
    text-wrap: pretty;
    text-align: left;
    width: 32%;
    padding-right: 0.75rem;
  }
  .compare th {
    text-align: left;
  }
  .compare td.gadak {
    font-weight: 600;
  }
  .compare > p {
    margin: 0 0 1.25rem;
    color: var(--ink-2);
  }
  .ask .note,
  .connect .note,
  .status .note {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin: 0.9rem 0 0;
    line-height: 1.8;
  }
  .ask .caution {
    font-size: 0.9375rem;
    color: var(--ink-2);
    margin: 0;
  }

  .exhibit {
    display: grid;
    gap: 1.75rem;
    margin-bottom: 3.5rem;
    align-items: start;
  }
  @media (min-width: 46rem) {
    .exhibit {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  .exhibit h2 {
    font-size: 1.25rem;
    margin: 0 0 0.6rem;
  }
  .exhibit p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9688rem;
  }

  section h2 {
    font-size: 1.375rem;
    margin: 0 0 0.75rem;
  }
  section > p {
    margin: 0 0 1rem;
    color: var(--ink-2);
    font-size: 1rem;
  }
  pre {
    margin: 0 0 1rem;
    padding: 1rem 1.25rem;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .media-pair {
    margin: 1.5rem 0;
  }
  .agent .note {
    font-size: 0.875rem;
    color: var(--ink-3);
    line-height: 1.8;
  }

  /* The two fact lists — before connecting, and status — share one shape:
     a hairline per item and a short stitch instead of a bullet. */
  .connect ul,
  .status ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .connect li,
  .status li {
    text-wrap: pretty;
    padding: 0.55rem 0 0.55rem 1.1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    position: relative;
    color: var(--ink-2);
  }
  .connect li :global(code),
  .status li :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    white-space: nowrap;
    color: var(--ink);
  }
  .connect li::before,
  .status li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 0.55rem;
    height: 1px;
    background: var(--accent);
  }
</style>
