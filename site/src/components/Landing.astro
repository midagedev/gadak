---
import Base from '../layouts/Base.astro'
import Door from '../components/Door.astro'
import Thread from '../components/Thread.astro'
import MediaSlot from '../components/MediaSlot.astro'
import Snippet from '../components/Snippet.astro'
import { strings, pathFor, mediaFor, type Locale } from '../i18n'

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const t = strings[lang]
const copyLabel = t.copy.label
const copiedLabel = t.copy.copied
const installHref = pathFor(lang, '/install/')
const storeHref = 'https://apps.microsoft.com/detail/9NZW91TXH36G'
const docs = 'https://github.com/midagedev/gadak/blob/main/'
// The sections and their order come from this locale's `layout` (i18n.ts):
// the three landings are parallel editions, not translations, so en opens
// with the objection an HN reader was about to type, ja puts the trust
// section before the agent one, and ko closes on the sentence the
// maintainer is asking for. One screen per idea still holds (user call
// 2026-09-05); a locale that has nothing to say in a section leaves it out
// of its layout rather than filling it.
const layout = t.layout
---

<Base lang={lang} title={t.title} description={t.description}>
  {
    layout.map((section) => (
      <>
        {section === 'hero' && (
          <section class="hero">
            <p class="eyebrow">{t.hero.eyebrow}</p>
            <h1>{t.hero.heading}</h1>
            <p class="lede">{t.hero.lede}</p>
            <div class="doors">
              <Door primary href={installHref} title={t.hero.doors.installTitle} sub={t.hero.doors.installSub} />
              <Door href="/demo/" title={t.hero.doors.demoTitle} sub={t.hero.doors.demoSub} />
            </div>
            <figure class="flagship">
              {/* Every clip on this page carries localized UI in its pixels, so
                  each asks mediaFor for this locale's cut and falls back to the
                  English take until that cut is recorded (MEDIA_LOCALES). */}
              <MediaSlot
                slot={t.landing.flagshipSlot}
                src={mediaFor(lang, '/media/scale.mp4')}
                poster={mediaFor(lang, '/media/scale-poster.png')}
                autoplay
              />
              <figcaption>{t.hero.videoCaption}</figcaption>
            </figure>
          </section>
        )}

        {section === 'compare' && t.compare && (
          <>
            <Thread label={t.compare.label} />
            {/* The objection every thread opens with, answered before it is
                asked — and answered honestly: the last row is the one gadak
                loses, on purpose. A table that wins every row reads as
                marketing and gets taken apart. */}
            <section class="speed compare">
              <h2>{t.compare.heading}</h2>
              <p>{t.compare.body}</p>
              <table>
                <thead>
                  <tr>
                    <th></th>
                    <th>{t.compare.colA}</th>
                    <th>{t.compare.colB}</th>
                  </tr>
                </thead>
                <tbody>
                  {t.compare.rows.map((row) => (
                    <tr>
                      <td class="what">{row.what}</td>
                      <td class="rest">{row.a}</td>
                      <td class="gadak">{row.b}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="note">
                {t.compare.note} <a href={`${docs}${t.compare.noteLink}`}>{t.compare.noteLink}</a>
              </p>
            </section>
          </>
        )}

        {section === 'speed' && (
          <>
            <Thread label={t.speed.label} />
            {/* The video says "fast"; the table says how much, against the
                thing people wait on today. Same question, two runtimes. */}
            <section class="speed">
              <h2>{t.speed.heading}</h2>
              <table>
                <thead>
                  <tr>
                    <th></th>
                    <th>{t.speed.colRest}</th>
                    <th>{t.speed.colGadak}</th>
                    <th aria-hidden="true"></th>
                  </tr>
                </thead>
                <tbody>
                  {t.speed.rows.map((row) => (
                    <tr>
                      <td class="what">{row.what}</td>
                      <td class="rest">{row.value}</td>
                      <td class="gadak">{row.alt}</td>
                      <td class="ratio">{row.ratio}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="note">
                {t.speed.note}
                <a href={`${docs}docs/BENCHMARKS.md`}>docs/BENCHMARKS.md</a>.
              </p>
            </section>
          </>
        )}

        {section === 'search' && (
          <>
            <Thread label={t.ux.label} />
            {/* One exhibit for the daily loop: search is the one everybody hits. */}
            <section class="exhibit">
              <div class="text">
                <h2>{t.ux.search.heading}</h2>
                <p>{t.ux.search.body}</p>
              </div>
              <MediaSlot
                slot={t.landing.searchSlot}
                src={mediaFor(lang, '/media/search.mp4')}
                poster={mediaFor(lang, '/media/search-poster.png')}
              />
            </section>
          </>
        )}

        {section === 'agent' && (
          <>
            <Thread label={t.agent.label} />
            <section class="agent">
              <h2>{t.agent.heading}</h2>
              <p>{t.agent.body}</p>
              <figure class="media-pair">
                {/* Claude Code in gadak's own pane, and the board it moves is
                    the one above it. 16:10, full column width. Each locale's
                    take is one language end to end (MEDIA_LOCALES). */}
                <MediaSlot
                  slot={t.landing.agentSlot}
                  src={mediaFor(lang, '/media/terminal-hero.mp4')}
                  poster={mediaFor(lang, '/media/terminal-hero-poster.png')}
                />
                <figcaption>{t.agent.driveCaption}</figcaption>
              </figure>
              <p>{t.agent.skillLead}</p>
              <Snippet code="gadak skill install" copyLabel={copyLabel} copiedLabel={copiedLabel} />
              <p>{t.agent.mcpLead}</p>
              <Snippet code="claude mcp add gadak -- gadak mcp" copyLabel={copyLabel} copiedLabel={copiedLabel} />
              <p class="note">
                <a href={`${docs}docs/AGENT_SETUP.md`}>{t.agent.setupLink}</a>
                <br />
                <a href={`${docs}docs/SHOWCASE.md`}>{t.agent.showcaseLink}</a>
              </p>
            </section>
          </>
        )}

        {section === 'origin' && (
          <>
            <Thread label={t.origin.label} />
            <section class="origin">
              <h2>{t.origin.heading}</h2>
              <ul>
                {t.origin.points.map((point) => <li>{point}</li>)}
              </ul>
              {t.origin.link && (
                <p class="note">
                  <a href={t.origin.link.href}>{t.origin.link.label}</a>
                </p>
              )}
            </section>
          </>
        )}

        {section === 'install' && (
          <>
            <Thread />
            <section class="install">
              <h2>{t.install.heading}</h2>
              <p>{t.install.macosApp}</p>
              <Snippet code="brew install --cask midagedev/tap/gadak" copyLabel={copyLabel} copiedLabel={copiedLabel} />
              <p>{t.install.cliOnly}</p>
              <Snippet code="brew install midagedev/tap/gadak-cli" copyLabel={copyLabel} copiedLabel={copiedLabel} />
              <p>{t.install.windowsBefore} <a href={storeHref}>Microsoft Store</a>{t.install.windowsAfter}</p>
              <p>{t.install.firstRun}</p>
              <Snippet code="gadak init && gadak sync && gadak serve" copyLabel={copyLabel} copiedLabel={copiedLabel} />
              <p class="note"><a href={installHref}>{t.landing.allPlatforms}</a></p>
            </section>
          </>
        )}

        {section === 'ask' && t.ask && (
          <>
            <Thread label={t.ask.label} />
            {/* ko only: no telemetry means the only retention signal is a
                human sentence, so the page ends by asking for one. */}
            <section class="ask">
              <h2>{t.ask.heading}</h2>
              <p>{t.ask.body}</p>
              <p class="note">
                {t.ask.links.map((l, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={l.href}>{l.label}</a>
                  </>
                ))}
              </p>
            </section>
          </>
        )}
      </>
    ))
  }
</Base>

<style>
  .hero {
    padding-top: 3.5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .hero h1 {
    font-size: 2.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0 0 1.1rem;
    max-width: 22ch;
  }
  .lede {
    font-size: 1.0625rem;
    color: var(--ink-2);
    margin: 0 0 2rem;
    max-width: 58ch;
  }
  .doors {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 40rem) {
    .doors {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .flagship {
    margin: 0;
  }
  figcaption {
    font-size: 0.8125rem;
    color: var(--ink-3);
    margin-top: 0.6rem;
  }

  .speed table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--border);
  }
  .speed th {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: right;
    color: var(--ink-3);
    padding: 0.5rem 0 0.35rem;
  }
  .speed th:first-child {
    text-align: left;
  }
  .speed td {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    text-align: right;
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .speed td.what {
    text-align: left;
    font-family: var(--font-sans);
    color: var(--ink-2);
    white-space: normal;
    padding-right: 1rem;
  }
  .speed td.rest {
    color: var(--ink-3);
  }
  /* A minimum gutter between the two value columns. Both are right-aligned,
     so the column's widest cell always ends flush at the column edge, and
     without this the gadak cell touches the Jira cell in that row: measured
     on the ja page at 1280, "429 + Retry-After" ran into 「なし — 自分の
     ディスク」 as one token (GDK-1500 vision round). Only the gadak side
     needs it — the Jira cell's left neighbour is the left-aligned label,
     which carries its own padding-right — and every pixel here comes out
     of the label column: 1.25rem on both sides wrapped two English labels. */
  .speed td.gadak {
    color: var(--ink);
    font-weight: 600;
    padding-left: 1rem;
  }
  .speed td.ratio {
    color: var(--accent);
    font-weight: 700;
    padding-left: 0.75rem;
  }
  /* Phone widths: value cells may wrap (numbers hold together via nbsp in
     the strings), otherwise the qualitative rows squeeze the first column
     down to one glyph per line. */
  @media (max-width: 40rem) {
    .speed td,
    .speed th {
      white-space: normal;
    }
    .speed td {
      font-size: 0.875rem;
    }
    .speed td.what {
      padding-right: 0.6rem;
    }
  }
  .speed .note {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin: 0.9rem 0 0;
  }
  /* The comparison table: same skeleton as the measurement table, but its
     cells are words, not numbers — so they wrap and set in the sans face,
     and the two value columns share the width evenly. */
  .compare td.rest,
  .compare td.gadak {
    font-family: var(--font-sans);
    white-space: normal;
    text-wrap: pretty;
    text-align: left;
    width: 32%;
    padding-right: 0.75rem;
  }
  .compare th {
    text-align: left;
  }
  .compare td.gadak {
    font-weight: 600;
  }
  .compare > p {
    margin: 0 0 1.25rem;
    color: var(--ink-2);
  }
  .ask .note,
  .origin .note {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin: 0.9rem 0 0;
    line-height: 1.8;
  }

  .exhibit {
    display: grid;
    gap: 1.75rem;
    margin-bottom: 3.5rem;
    align-items: start;
  }
  @media (min-width: 46rem) {
    .exhibit {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  .exhibit h2 {
    font-size: 1.25rem;
    margin: 0 0 0.6rem;
  }
  .exhibit p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9688rem;
  }

  section h2 {
    font-size: 1.375rem;
    margin: 0 0 0.75rem;
  }
  section > p {
    margin: 0 0 1rem;
    color: var(--ink-2);
    font-size: 1rem;
  }
  pre {
    margin: 0 0 1rem;
    padding: 1rem 1.25rem;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .media-pair {
    margin: 1.5rem 0;
  }
  .agent .note {
    font-size: 0.875rem;
    color: var(--ink-3);
    line-height: 1.8;
  }

  .origin ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .origin li {
    text-wrap: pretty;
    padding: 0.55rem 0 0.55rem 1.1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    position: relative;
    color: var(--ink-2);
  }
  .origin li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 0.55rem;
    height: 1px;
    background: var(--accent);
  }
</style>
