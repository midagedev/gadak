---
import Base from '../layouts/Base.astro'
import Door from '../components/Door.astro'
import Thread from '../components/Thread.astro'
import MediaSlot from '../components/MediaSlot.astro'
import Snippet from '../components/Snippet.astro'
import { strings, pathFor, mediaFor, type Locale } from '../i18n'
import { latestEssay } from '../lib/essays'

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const t = strings[lang]
const copyLabel = t.copy.label
const copiedLabel = t.copy.copied
const installHref = pathFor(lang, '/install/')
const storeHref = 'https://apps.microsoft.com/detail/9NZW91TXH36G'
// The newest essay written in this locale, if any — the pointer below the
// trust section. A locale with no essay of its own renders no pointer
// rather than an English one under a Korean or Japanese page.
const essay = await latestEssay(lang)
---

<Base lang={lang} title={t.title} description={t.description}>
  {/* Five sections, in the order a reader decides: the promise and one
      recording, the measurement, one exhibit of the daily loop, the agent
      surface with one recording, then trust and install. Everything else
      that used to be here is a gallery now — docs/SHOWCASE.md — so the
      landing stays one screen per idea (user call 2026-09-05). */}
  <section class="hero">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1>{t.hero.heading}</h1>
    <p class="lede">{t.hero.lede}</p>
    <div class="doors">
      <Door primary href={installHref} title={t.hero.doors.installTitle} sub={t.hero.doors.installSub} />
      <Door href="/demo/" title={t.hero.doors.demoTitle} sub={t.hero.doors.demoSub} />
    </div>
    <figure class="flagship">
      {/* Every clip on this page carries localized UI in its pixels — the
          agent one further down included, since its ko and ja takes are one
          language end to end — so each asks mediaFor for this locale's cut
          and falls back to the English take until that cut is recorded
          (MEDIA_LOCALES in i18n.ts). */}
      <MediaSlot
        slot={t.landing.flagshipSlot}
        src={mediaFor(lang, '/media/scale.mp4')}
        poster={mediaFor(lang, '/media/scale-poster.png')}
        autoplay
      />
      <figcaption>{t.hero.videoCaption}</figcaption>
    </figure>
  </section>

  <Thread label={t.speed.label} />

  {/* The video says "fast"; the table says how much, against the thing
      people wait on today. Same question, two runtimes. */}
  <section class="speed">
    <h2>{t.speed.heading}</h2>
    <table>
      <thead>
        <tr>
          <th></th>
          <th>{t.speed.colRest}</th>
          <th>{t.speed.colGadak}</th>
          <th aria-hidden="true"></th>
        </tr>
      </thead>
      <tbody>
        {
          t.speed.rows.map((row) => (
            <tr>
              <td class="what">{row.what}</td>
              <td class="rest">{row.value}</td>
              <td class="gadak">{row.alt}</td>
              <td class="ratio">{row.ratio}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="note">
      {t.speed.note}
      <a href="https://github.com/midagedev/gadak/blob/main/docs/BENCHMARKS.md">docs/BENCHMARKS.md</a>.
    </p>
  </section>

  <Thread label={t.ux.label} />

  {/* One exhibit for the daily loop: search is the one everybody hits. */}
  <section class="exhibit">
    <div class="text">
      <h2>{t.ux.search.heading}</h2>
      <p>{t.ux.search.body}</p>
    </div>
    <MediaSlot
      slot={t.landing.searchSlot}
      src={mediaFor(lang, '/media/search.mp4')}
      poster={mediaFor(lang, '/media/search-poster.png')}
    />
  </section>

  <Thread label={t.agent.label} />

  <section class="agent">
    <h2>{t.agent.heading}</h2>
    <p>{t.agent.body}</p>
    <figure class="media-pair">
      {/* The window itself: Claude Code in gadak's own pane, and the board
          it moves is the one above it. 16:10, full column width.

          Localized like the two clips above since 2026-09-07: each locale's
          take is one language end to end — chrome, mirror and the prompts
          typed into the pane — so this asks mediaFor for this locale's cut
          and falls back to the English take until it is recorded
          (MEDIA_LOCALES in i18n.ts). */}
      <MediaSlot
        slot={t.landing.agentSlot}
        src={mediaFor(lang, '/media/terminal-hero.mp4')}
        poster={mediaFor(lang, '/media/terminal-hero-poster.png')}
      />
      <figcaption>{t.agent.driveCaption}</figcaption>
    </figure>
    <p>{t.agent.skillLead}</p>
    <Snippet code="gadak skill install" copyLabel={copyLabel} copiedLabel={copiedLabel} />
    <p>{t.agent.mcpLead}</p>
    <Snippet code="claude mcp add gadak -- gadak mcp" copyLabel={copyLabel} copiedLabel={copiedLabel} />
    <p class="note">
      <a href="https://github.com/midagedev/gadak/blob/main/docs/AGENT_SETUP.md">{t.agent.setupLink}</a>
      <br />
      <a href="https://github.com/midagedev/gadak/blob/main/docs/SHOWCASE.md">{t.agent.showcaseLink}</a>
    </p>
  </section>

  <Thread label={t.origin.label} />

  <section class="origin">
    <h2>{t.origin.heading}</h2>
    <ul>
      {t.origin.points.map((point) => <li>{point}</li>)}
    </ul>
  </section>

  {
    essay && (
      <>
        <Thread label={t.landing.essayLabel} />
        {/* One essay, not a shelf: the argument behind the newest release,
            in this locale's own words. The five-section rule (user call
            2026-09-05) stays — this is a pointer, the size of a door, not a
            sixth idea with its own exhibit. Title and description are the
            essay's frontmatter, so the landing never carries a second copy. */}
        <section class="essay">
          <a class="essay-card" href={pathFor(lang, `/essays/${essay.slug}/`)}>
            <span class="essay-date">{essay.date}</span>
            <span class="essay-title">{essay.title}</span>
            <span class="essay-desc">{essay.description}</span>
            <span class="essay-read">{t.landing.readEssay}</span>
          </a>
        </section>
      </>
    )
  }

  <Thread />

  <section class="install">
    <h2>{t.install.heading}</h2>
    <p>{t.install.macosApp}</p>
    <Snippet code="brew install --cask midagedev/tap/gadak" copyLabel={copyLabel} copiedLabel={copiedLabel} />
    <p>{t.install.cliOnly}</p>
    <Snippet code="brew install midagedev/tap/gadak-cli" copyLabel={copyLabel} copiedLabel={copiedLabel} />
    <p>{t.install.windowsBefore} <a href={storeHref}>Microsoft Store</a>{t.install.windowsAfter}</p>
    <p>{t.install.firstRun}</p>
    <Snippet code="gadak init && gadak sync && gadak serve" copyLabel={copyLabel} copiedLabel={copiedLabel} />
    <p class="note"><a href={installHref}>{t.landing.allPlatforms}</a></p>
  </section>
</Base>

<style>
  .hero {
    padding-top: 3.5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .hero h1 {
    font-size: 2.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0 0 1.1rem;
    max-width: 22ch;
  }
  .lede {
    font-size: 1.0625rem;
    color: var(--ink-2);
    margin: 0 0 2rem;
    max-width: 58ch;
  }
  .doors {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 40rem) {
    .doors {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .flagship {
    margin: 0;
  }
  figcaption {
    font-size: 0.8125rem;
    color: var(--ink-3);
    margin-top: 0.6rem;
  }

  .speed table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--border);
  }
  .speed th {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: right;
    color: var(--ink-3);
    padding: 0.5rem 0 0.35rem;
  }
  .speed th:first-child {
    text-align: left;
  }
  .speed td {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    text-align: right;
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .speed td.what {
    text-align: left;
    font-family: var(--font-sans);
    color: var(--ink-2);
    white-space: normal;
    padding-right: 1rem;
  }
  .speed td.rest {
    color: var(--ink-3);
  }
  /* A minimum gutter between the two value columns. Both are right-aligned,
     so the column's widest cell always ends flush at the column edge, and
     without this the gadak cell touches the Jira cell in that row: measured
     on the ja page at 1280, "429 + Retry-After" ran into 「なし — 自分の
     ディスク」 as one token (GDK-1500 vision round). Only the gadak side
     needs it — the Jira cell's left neighbour is the left-aligned label,
     which carries its own padding-right — and every pixel here comes out
     of the label column: 1.25rem on both sides wrapped two English labels. */
  .speed td.gadak {
    color: var(--ink);
    font-weight: 600;
    padding-left: 1rem;
  }
  .speed td.ratio {
    color: var(--accent);
    font-weight: 700;
    padding-left: 0.75rem;
  }
  /* Phone widths: value cells may wrap (numbers hold together via nbsp in
     the strings), otherwise the qualitative rows squeeze the first column
     down to one glyph per line. */
  @media (max-width: 40rem) {
    .speed td,
    .speed th {
      white-space: normal;
    }
    .speed td {
      font-size: 0.875rem;
    }
    .speed td.what {
      padding-right: 0.6rem;
    }
  }
  .speed .note {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin: 0.9rem 0 0;
  }

  .exhibit {
    display: grid;
    gap: 1.75rem;
    margin-bottom: 3.5rem;
    align-items: start;
  }
  @media (min-width: 46rem) {
    .exhibit {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  .exhibit h2 {
    font-size: 1.25rem;
    margin: 0 0 0.6rem;
  }
  .exhibit p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9688rem;
  }

  section h2 {
    font-size: 1.375rem;
    margin: 0 0 0.75rem;
  }
  section > p {
    margin: 0 0 1rem;
    color: var(--ink-2);
    font-size: 1rem;
  }
  pre {
    margin: 0 0 1rem;
    padding: 1rem 1.25rem;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .media-pair {
    margin: 1.5rem 0;
  }
  .agent .note {
    font-size: 0.875rem;
    color: var(--ink-3);
    line-height: 1.8;
  }

  .origin ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .origin li {
    padding: 0.55rem 0 0.55rem 1.1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    position: relative;
    color: var(--ink-2);
  }
  .origin li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 0.55rem;
    height: 1px;
    background: var(--accent);
  }

  /* The essay pointer is a door with a paragraph in it — same panel, border
     and hover as Door.astro, so it reads as one more of the site's doors
     rather than a new component. */
  .essay-card {
    display: grid;
    gap: 0.35rem;
    padding: 1.15rem 1.35rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 120ms ease,
      background 120ms ease;
  }
  .essay-card:hover {
    background: var(--elevated);
    border-color: var(--border-strong);
  }
  .essay-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }
  .essay-title {
    font-weight: 620;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .essay-desc {
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 62ch;
  }
  .essay-read {
    margin-top: 0.35rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9375rem;
  }
</style>
