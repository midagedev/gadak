---
import Base from '../layouts/Base.astro'
import { essayIndex } from '../lib/essays'
import { strings, pathFor, type Locale } from '../i18n'
import '../styles/changelog.css'

// The essays shelf in one locale. Every essay is listed; a row whose essay
// has no copy in this locale links to the English original and says so.
interface Props {
  lang: Locale
}
const { lang } = Astro.props
const t = strings[lang]
const rows = await essayIndex(lang)
const origin = Astro.site ? Astro.site.href.replace(/\/$/, '') : ''
const hrefOf = (row: (typeof rows)[number]) =>
  row.fallback ? `/essays/${row.slug}/` : pathFor(lang, `/essays/${row.slug}/`)

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'gadak essays',
  inLanguage: lang,
  itemListElement: rows.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.title,
    url: `${origin}${hrefOf(e)}`,
  })),
})
---

<Base lang={lang} title={t.essays.title} description={t.essays.lede} jsonLd={jsonLd}>
  <article class="changelog">
    <h1>{t.essays.heading}</h1>
    <p class="lede">{t.essays.lede}</p>

    {
      rows.map((e) => (
        <section>
          <h2>
            <a href={hrefOf(e)}>{e.title}</a>
          </h2>
          <p class="note">
            <time datetime={e.date}>{e.date}</time>
            {e.fallback && <> · {t.essays.inEnglish}</>}
          </p>
          <p>{e.description}</p>
        </section>
      ))
    }
  </article>
</Base>
