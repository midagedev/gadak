---
import Base from '../layouts/Base.astro'
import type { Essay } from '../lib/essays'
import { pathFor } from '../i18n'
import '../styles/changelog.css'

// One essay page, any locale. The three route files under pages/ are thin:
// they pick the locale and hand the essay here, so the head, the JSON-LD and
// the article shape have one owner.
interface Props {
  essay: Essay
}
const { essay } = Astro.props
const origin = Astro.site ? Astro.site.href.replace(/\/$/, '') : ''
const url = `${origin}${pathFor(essay.lang, `/essays/${essay.slug}/`)}`

// Same honesty rule as the changelog page: every field is read off the
// essay's own frontmatter or off site facts, nothing asserted for the
// crawler that the page does not also show. inLanguage is what keeps a
// translation from reading as a duplicate of the original.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: essay.title,
  description: essay.description,
  datePublished: essay.date,
  inLanguage: essay.lang,
  mainEntityOfPage: url,
  url,
  image: `${origin}/og.png`,
  author: { '@type': 'Person', name: 'midagedev', url: 'https://github.com/midagedev' },
})
---

<Base
  lang={essay.lang}
  noAltLang={essay.locales.length === 1}
  title={essay.title}
  description={essay.description}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="changelog">
    <h1>{essay.title}</h1>
    <p class="note"><time datetime={essay.date}>{essay.date}</time></p>
    <Fragment set:html={essay.html} />
  </article>
</Base>
