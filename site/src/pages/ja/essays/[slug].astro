---
import EssayArticle from '../../../components/EssayArticle.astro'
import { listEssays } from '../../../lib/essays'

// Only essays that exist in this locale get a page here; the rest are
// reached from this locale's index as English.
export async function getStaticPaths() {
  return (await listEssays('ja')).map((essay) => ({ params: { slug: essay.slug }, props: { essay } }))
}

const { essay } = Astro.props
---

<EssayArticle essay={essay} />
