---
import Base from '../../layouts/Base.astro'
import { renderChangelog, changelogIsFallback } from '../../lib/changelog'
import { strings } from '../../i18n'
import '../../styles/changelog.css'

const t = strings.ja
const { html, releases } = await renderChangelog('ja')
const dated = releases.filter((r) => r.date)

// Same two objects as the English page (src/pages/changelog.astro), pointed
// at the ja URLs, following the ko page's pattern. inLanguage is what keeps
// the mirrored pages from reading as duplicates of one another. The body
// renders the English CHANGELOG.md on purpose (no CHANGELOG.ja.md) and says
// so below — GDK-1500.
const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'gadak',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows',
    inLanguage: 'ja',
    url: 'https://gadak.dev/ja/',
    downloadUrl: 'https://gadak.dev/ja/install/',
    softwareVersion: dated[0]?.label.replace(/^v/, ''),
    releaseNotes: 'https://gadak.dev/ja/changelog/',
    sameAs: 'https://github.com/midagedev/gadak',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'gadak releases',
    itemListElement: dated.slice(0, 20).map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: r.label,
      url: `https://gadak.dev/ja/changelog/#${r.id}`,
    })),
  },
])
---

<Base
  lang="ja"
  title="変更履歴｜gadak のリリースノート"
  description="gadak のすべてのリリースを、出した本人の言葉で。リポジトリの CHANGELOG.md から描画しています。課題キーは公開バックログにリンクします。本文は英語です。"
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="changelog">
    <h1>{t.changelog.heading}</h1>
    <p class="lede">{t.changelog.lede}</p>
    <p class="note">
      {t.changelog.source}{' '}
      <a href="https://github.com/midagedev/gadak/blob/main/CHANGELOG.md">GitHubで見る</a>
    </p>
    {changelogIsFallback('ja') && <p class="note">{t.changelog.fallbackNote}</p>}

    {
      dated.length > 0 && (
        <nav class="versions" aria-label={t.changelog.jumpLabel}>
          <span class="versions-label">{t.changelog.jumpLabel}</span>
          {dated.slice(0, 12).map((r) => (
            <a href={`#${r.id}`}>{r.label}</a>
          ))}
        </nav>
      )
    }

    <Fragment set:html={html} />
  </article>
</Base>
