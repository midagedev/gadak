---
import Base from '../layouts/Base.astro'
import { renderChangelog } from '../lib/changelog'
import { strings } from '../i18n'
import '../styles/changelog.css'

const t = strings.en
const { html, releases } = await renderChangelog('en')
const dated = releases.filter((r) => r.date)

// Two things a search engine can use and a reader cannot see: the software
// itself (so a "gadak" query can show what it is and that it is free), and
// the releases as a dated list (so a version query has something to match).
// Every field here is read off the changelog or off package facts — nothing
// asserted for the crawler that is not also true on the page.
const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'gadak',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows, iOS',
    url: 'https://gadak.dev/',
    downloadUrl: 'https://gadak.dev/install/',
    softwareVersion: dated[0]?.label.replace(/^v/, ''),
    releaseNotes: 'https://gadak.dev/changelog/',
    sameAs: 'https://github.com/midagedev/gadak',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'gadak releases',
    itemListElement: dated.slice(0, 20).map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: r.label,
      url: `https://gadak.dev/changelog/#${r.id}`,
    })),
  },
])
---

<Base
  lang="en"
  title="Changelog — gadak release notes"
  description="Every gadak release, in the words of the person who shipped it — rendered from the repository's CHANGELOG.md, with issue keys linking into the public backlog."
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="changelog">
    <h1>{t.changelog.heading}</h1>
    <p class="lede">{t.changelog.lede}</p>
    <p class="note">
      {t.changelog.source}{' '}
      <a href="https://github.com/midagedev/gadak/blob/main/CHANGELOG.md">View on GitHub</a>
    </p>

    {
      dated.length > 0 && (
        <nav class="versions" aria-label={t.changelog.jumpLabel}>
          <span class="versions-label">{t.changelog.jumpLabel}</span>
          {dated.slice(0, 12).map((r) => (
            <a href={`#${r.id}`}>{r.label}</a>
          ))}
        </nav>
      )
    }

    <Fragment set:html={html} />
  </article>
</Base>
