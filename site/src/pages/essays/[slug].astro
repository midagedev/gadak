---
import EssayArticle from '../../components/EssayArticle.astro'
import { listEssays } from '../../lib/essays'

export async function getStaticPaths() {
  return (await listEssays('en')).map((essay) => ({ params: { slug: essay.slug }, props: { essay } }))
}

const { essay } = Astro.props
---

<EssayArticle essay={essay} />
