---
import Base from '../layouts/Base.astro'
import { strings } from '../i18n'
const t = strings.en
---

<Base
  lang="en"
  title={`Install — gadak`}
  description="Install gadak: the macOS app and CLI via Homebrew, a Linux CLI via Homebrew or a release tarball, and Windows release zips."
>
  <h1>{t.install.heading}</h1>

  <h2>macOS</h2>
  <pre><code>{`brew install --cask midagedev/tap/gadak   # app (CLI included)
brew install midagedev/tap/gadak-cli     # CLI only`}</code></pre>

  <h2>Linux</h2>
  <pre><code>{`brew install midagedev/tap/gadak-cli     # Homebrew on Linux

# or the tarball for your arch:
# https://github.com/midagedev/gadak/releases`}</code></pre>

  <h2>Windows</h2>
  <pre><code>{`# portable zip per release:
# https://github.com/midagedev/gadak/releases`}</code></pre>

  <h2>First run</h2>
  <pre><code>{`# connect to your team's workspace
gadak init && gadak sync && gadak serve

# or start with no tracker at all
gadak init --standalone
gadak create "the thing I just noticed"
gadak serve`}</code></pre>
</Base>

<style>
  h1 {
    font-size: 2rem;
    margin: 4rem 0 1.5rem;
  }
  h2 {
    font-size: 1.125rem;
    margin: 2.25rem 0 0.75rem;
  }
  pre {
    padding: 1rem 1.25rem;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }
</style>
