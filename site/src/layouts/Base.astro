---
import '../styles/tokens.css'
import { LOCALES, strings, otherLocales, pathFor, enPathOf, mediaFor, type Locale } from '../i18n'

interface Props {
  lang: Locale
  title: string
  description: string
  /** og:type. 'website' for the landing pages; 'article' for dated writing. */
  ogType?: 'website' | 'article'
  /** JSON-LD, already stringified by the page. Emitted verbatim in <head>. */
  jsonLd?: string
  /**
   * This page has no mirror in the other locales (an essay without translations).
   * The head then claims no hreflang alternates — an alternate that 404s is
   * worse than none — no language banner is rendered (the page is not
   * offered in any other locale), and the header switcher links to each
   * other locale's home instead of a dead path.
   */
  noAltLang?: boolean
}
const { lang, title, description, ogType = 'website', jsonLd, noAltLang = false } = Astro.props
const t = strings[lang]
const origin = Astro.site ? Astro.site.href.replace(/\/$/, '') : ''
// This page's en path — the single source every locale's mirror derives
// from: en '/' ↔ ko '/ko/' ↔ ja '/ja/', en '/install/' ↔ '/ko/install/' ….
const enPath = enPathOf(Astro.url.pathname)
const others = otherLocales(lang)
// Where the switcher and banners point for locale l: that locale's copy of
// this page, or its home when this page exists in no other locale.
const switchHref = (l: Locale) => (noAltLang ? pathFor(l, '/') : pathFor(l, enPath))
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="gadak" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${origin}${Astro.url.pathname}`} />
    <meta property="og:locale" content={t.ogLocale} />
    {!noAltLang &&
      others.map((l) => <meta property="og:locale:alternate" content={strings[l].ogLocale} />)}
    {/* The card has the tagline baked into its pixels, so it is a per-locale
        asset like the clips — served from /media/, where the locale variants
        the brand render writes actually live. /og.png stays where it is: the
        demo and backlog apps (tools/hosted-demo/build.mjs) are en-only and
        still point at it. */}
    <meta property="og:image" content={`${origin}${mediaFor(lang, '/media/og.png')}`} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Canonical on the page's own URL. Without it the same document is
        reachable at more than one address (trailing slash, query, the
        preview host) and search engines pick a winner for us. */}
    <link rel="canonical" href={`${origin}${Astro.url.pathname}`} />
    {!noAltLang && (
      <>
        {LOCALES.map((l) => (
          <link rel="alternate" hreflang={l} href={`${origin}${pathFor(l, enPath)}`} />
        ))}
        <link rel="alternate" hreflang="x-default" href={`${origin}${enPath}`} />
      </>
    )}
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f4efe4" />
    {/* Cloudflare Web Analytics — cookieless, marketing pages only. The
        demo/backlog apps stay beacon-free on purpose: they are the product,
        and the product's promise is no outbound. */}
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={'{"token": "abaadb0b53564824861e279a693d3fc8"}'}
    ></script>
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
  </head>
  <body>
    {/* Locale suggestion, never a forced redirect: static and hidden; the
        inline script below reveals at most one — the visitor's own locale —
        only when the browser's primary language matches one of the other
        locales and no explicit choice is stored. */}
    {!noAltLang &&
      others.map((l) => {
        const b = strings[l]
        return (
          <div class="lang-banner" data-lang-banner={l} hidden>
            <div class="lang-banner-inner">
              <span>{b.langBanner.offer}</span>
              <a data-lang-choice={l} href={switchHref(l)}>{b.langBanner.cta}</a>
              <button type="button" data-lang-banner-dismiss aria-label={b.langBanner.dismiss}>×</button>
            </div>
          </div>
        )
      })}
    <header>
      <nav>
        <a class="wordmark" href={pathFor(lang, '/')}>gadak</a>
        <div class="links">
          <a href="/demo/">{t.nav.demo}</a>
          {/* The raw backlog app stays deployed (CHANGELOG issue links point
              into it) but is not advertised here — the curated story is the
              changelog (user call 2026-08-24). It is served here rather than
              on GitHub: the releases are the strongest evidence this site has
              that the thing is alive, and sending that traffic away spends it
              somewhere else. */}
          <a href={pathFor(lang, '/changelog/')}>{t.nav.changelog}</a>
          {/* Each locale has an essays index of its own since 0.21: the
              shelf is the same, the rows link to that locale's copy where
              one exists and mark the rest as English. */}
          <a href={pathFor(lang, '/essays/')}>{t.nav.essays}</a>
          <a href={pathFor(lang, '/install/')}>{t.nav.install}</a>
          <a href="https://github.com/midagedev/gadak">{t.nav.github}</a>
          {others.map((l) => (
            <a data-lang-choice={l} href={switchHref(l)}>{strings[l].langName}</a>
          ))}
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="inner">
        {t.footer.builtBy}
        <a href="https://github.com/midagedev">midagedev</a> ·
        <a href="https://github.com/midagedev/gadak">GitHub</a> ·
        <a href="https://github.com/midagedev/gadak/blob/main/SECURITY.md">{t.footer.whereBytes}</a>
      </div>
    </footer>
    <script is:inline define:vars={{ pageLang: lang, others }}>
      // Language memory: any [data-lang-choice] click (nav switcher, banner
      // CTA) records an explicit choice; the banner shows only before one
      // exists, so detection never overrides the user.
      ;(function () {
        var KEY = 'gadak-lang'
        var read = function () {
          try {
            return localStorage.getItem(KEY)
          } catch (e) {
            return null
          }
        }
        var write = function (v) {
          try {
            localStorage.setItem(KEY, v)
          } catch (e) {}
        }
        document.addEventListener('click', function (e) {
          var el = e.target && e.target.closest ? e.target.closest('[data-lang-choice]') : null
          if (el) write(el.getAttribute('data-lang-choice'))
        })
        if (read()) return
        var primary = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase()
        var wants = primary.split('-')[0]
        // Reveal at most one banner: the copy in the locale the browser
        // actually asked for. A primary language this page has no other
        // copy in (or a stored choice) means no banner at all.
        if (others.indexOf(wants) === -1) return
        var banner = document.querySelector('[data-lang-banner="' + wants + '"]')
        if (!banner) return
        banner.hidden = false
        var dismiss = banner.querySelector('[data-lang-banner-dismiss]')
        if (dismiss)
          dismiss.addEventListener('click', function () {
            banner.hidden = true
            write(pageLang)
          })
      })()
    </script>
  </body>
</html>

<style>
  .lang-banner {
    border-bottom: 1px solid var(--border);
    background: var(--code-bg);
  }
  .lang-banner-inner {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0.5rem 1.5rem;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .lang-banner a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .lang-banner button {
    margin-left: auto;
    background: none;
    border: none;
    color: var(--ink-3);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0.25rem;
  }
  .lang-banner button:hover {
    color: var(--ink);
  }
  header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  nav {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .wordmark {
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    column-gap: 1.25rem;
    row-gap: 0.2rem;
  }
  .links a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9375rem;
    /* An item never wraps inside itself ("Live demo", "라이브 데모");
       the row wraps between items instead. */
    white-space: nowrap;
  }
  @media (max-width: 40rem) {
    .links {
      column-gap: 0.9rem;
    }
  }
  .links a:hover {
    color: var(--accent);
  }
  footer {
    border-top: 1px solid var(--border);
    margin-top: 5rem;
  }
  footer .inner {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.5rem;
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  footer a {
    color: var(--accent);
    text-decoration: none;
  }
  footer a:hover {
    text-decoration: underline;
  }
</style>
