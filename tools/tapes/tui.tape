# scry TUI demo — list → filter → tabs → detail → quit
# Regenerated by `make media-tui`. Requires: vhs, tools/tapes/prepare.sh
#
# Font: D2Coding is installed on this machine (fc-list / system_profiler).
# It covers Hangul so Korean status labels from the demo seed render aligned.
# If D2Coding is missing on another host, remove Set FontFamily (or point at
# Sarasa Mono K / Noto Sans Mono CJK) — without a CJK mono font, Hangul cells
# mis-width and columns drift.

Output docs/media/tui.gif

# Binary is built by tools/tapes/prepare.sh into tools/tapes/.tmp (on PATH via env.sh).

Set Shell "bash"
Set FontSize 16
Set FontFamily "D2Coding, Menlo, Monaco, monospace"
Set Width 1100
Set Height 620
Set Theme "Catppuccin Mocha"
Set Padding 16
Set Framerate 12
Set TypingSpeed 70ms
Set WindowBar Colorful
Set BorderRadius 6

# Neutral shell: no user@host, no real $HOME path.
Hide
Type "source tools/tapes/.tmp/env.sh"
Enter
Type "clear"
Enter
Show

Sleep 400ms

# Launch the navigator against the demo mirror.
Type "scry tui"
Enter

# Wait until the list has rendered. +Screen matches the full buffer (not only
# the status bar line, which never contains issue keys).
Wait+Screen@20s /NMB-/
Sleep 1.5s

# ── Filter: / then type ────────────────────────────────────────────────────
Type "/"
Sleep 400ms
Type "pagination"
Sleep 1.5s
# Leave filter mode (filter text stays applied).
Enter
Sleep 1s

# ── Tab switch: 2 = open, 3 = in progress ──────────────────────────────────
Type "2"
Sleep 1.2s
Type "3"
Sleep 1.2s

# ── Open detail on the selected row ────────────────────────────────────────
Enter
# Detail view shows the issue key again in the header plus body text.
Sleep 2.5s

# ── Back to list, quit ─────────────────────────────────────────────────────
Escape
Sleep 800ms
Type "q"
Sleep 600ms
