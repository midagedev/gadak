# scry CLI / agent demo — "one SQL shot answers the question"
# Regenerated by `make media-agent`. Requires: vhs, tools/tapes/prepare.sh
#
# Message: an agent does not scrape a UI — it queries the local mirror.
# Sequence: search → aggregate SQL → issue detail → status --json
#
# Font: D2Coding for Hangul in status labels (see tui.tape comment).

Output docs/media/agent.gif

# Binary is built by tools/tapes/prepare.sh into tools/tapes/.tmp (on PATH via env.sh).

Set Shell "bash"
Set FontSize 15
Set FontFamily "D2Coding, Menlo, Monaco, monospace"
Set Width 1000
Set Height 560
Set Theme "Catppuccin Mocha"
Set Padding 14
Set Framerate 12
Set TypingSpeed 55ms
Set WindowBar Colorful
Set BorderRadius 6

# Strip identity from the prompt before anything is shown.
Hide
Type "source tools/tapes/.tmp/env.sh"
Enter
Type "clear"
Enter
Show

Sleep 400ms

# ── Full-text search (local FTS, no network) ───────────────────────────────
# VHS Type strings are double-quoted; avoid nested \" escapes (parser breaks).
Type "scry search pagination --limit 5"
Enter
Sleep 2s

# ── One SQL aggregate — the agent story ────────────────────────────────────
# Single-quoted SQL payload so the tape string stays simple.
Type "scry sql 'select project_key, count(*) n from issues group by project_key order by n desc'"
Enter
Sleep 2.2s

# ── Hydrated single-issue read ─────────────────────────────────────────────
Type "scry issue NMB-110"
Enter
Sleep 2.5s

# ── Mirror freshness as JSON (pipe-friendly for agents) ────────────────────
Type "scry status --json"
Enter
Sleep 2s

# Rest frame so the last line is readable on loop.
Sleep 1s
