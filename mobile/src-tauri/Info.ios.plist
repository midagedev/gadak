<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Source-managed iOS plist additions — tauri merges this into the
     generated gen/apple Info.plist at bundle time, so the keys survive
     project regeneration. The camera string is required before any QR scan
     (tauri-plugin-barcode-scanner, PairGate/PairingTab). -->
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Scans the gadak pairing code shown on your computer.</string>
	<!-- Export compliance. The app carries no cryptography of its own: it
	     talks to a paired `gadak serve` over HTTPS/WSS and nothing else
	     (grep for crypto/hmac/aes under mobile/src and src-tauri/src comes
	     back empty). That is the standard exemption, so the answer is
	     false. Without this key every upload parks in "Missing Compliance"
	     and never reaches a tester until someone answers by hand. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
