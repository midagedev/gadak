# Dependencies
node_modules/
vendor/

# Build outputs. dist/app/.placeholder stays tracked so `go build` works
# before the first `npm run build` (embed.go needs the directory to exist).
dist/*
!dist/app
dist/app/*
!dist/app/.placeholder
bin/
build/
coverage/

# Local runtime data
.scry/
*.db
*.db-shm
*.db-wal
tmp/
.private/
e2e/.tmp/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Exception: the committed demo snapshot
!examples/demo.db

# Environment
.env
.env.*
!.env.example

# Go
*.test
*.out

# OS and editor
.DS_Store
.idea/
.vscode/

# goreleaser output (see .goreleaser.yaml `dist:`)
.release/
